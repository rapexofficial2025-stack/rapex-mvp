# Copy to .env.local and fill in for local development.
# Alpha: temporary GitHub deployment URL (production admin domain not ready yet).
VITE_ADMIN_API_BASE_URL=

# Django backend for the API Keys (Integrations) screen. Defaults to
# http://localhost:8000 if unset. Point this at the real deployed backend
# once it exists.
VITE_DJANGO_API_BASE_URL=

# Google Maps (full order map: customer/merchant/rider pins)
VITE_GOOGLE_MAPS_API_KEY=

# Firebase web config (studio-9520309954-bfd24) -- public client config,
# not a secret, but kept in .env.local like everything else here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
