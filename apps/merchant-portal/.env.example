# Copy to .env.local and fill in for local development.
# Production value: https://rapexmarketplace.ph
VITE_API_BASE_URL=

# Google Maps (store location picker, delivery coverage radius)
VITE_GOOGLE_MAPS_API_KEY=

# Firebase web config -- public client config, not a secret, but kept in
# .env.local like everything else here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Sentry crash reporting (sentry.io -> Settings -> Projects -> Client Keys).
# See src/services/sentry.ts -- crash reporting stays off (errors only
# logged locally in dev) until this is set.
VITE_SENTRY_DSN=
