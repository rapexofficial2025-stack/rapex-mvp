# Copy to .env.local and fill in for local development.
# Production value: https://rapexmarketplace.ph
EXPO_PUBLIC_API_BASE_URL=

# Real Xano rapex-auth API group. Defaults to the live handover URL if unset:
# https://x8ki-letl-twmt.n7.xano.io/api:rapex-auth
EXPO_PUBLIC_AUTH_API_BASE_URL=

# Real Xano rapex-orders API group (unverified live -- see XanoOrdersRepository).
# Defaults to https://x8ki-letl-twmt.n7.xano.io/api:rapex-orders
EXPO_PUBLIC_ORDERS_API_BASE_URL=

# Real Xano rapex-finance API group (unverified live -- see XanoWalletRepository).
# Defaults to https://x8ki-letl-twmt.n7.xano.io/api:rapex-finance
EXPO_PUBLIC_FINANCE_API_BASE_URL=

# Google Maps (Maps SDK Android/iOS, Places, Directions, Distance Matrix)
# used for delivery location picking, rider tracking, and ETA display.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
