# Copy to .env.local and fill in for local development.
# Production value: https://rapexmarketplace.ph
EXPO_PUBLIC_API_BASE_URL=

# Real Xano rapex-auth API group. Defaults to the live handover URL if unset:
# https://x8ki-letl-twmt.n7.xano.io/api:rapex-auth
EXPO_PUBLIC_AUTH_API_BASE_URL=

# Real Xano rapex-orders API group (unverified live -- see XanoOrdersRepository).
# Defaults to https://x8ki-letl-twmt.n7.xano.io/api:rapex-orders
EXPO_PUBLIC_ORDERS_API_BASE_URL=

# Real Xano rapex-finance API group (unverified live -- see XanoWalletRepository).
# Defaults to https://x8ki-letl-twmt.n7.xano.io/api:rapex-finance
EXPO_PUBLIC_FINANCE_API_BASE_URL=

# Google Maps (Maps SDK Android/iOS, Places, Directions, Distance Matrix)
# used for delivery location picking, rider tracking, and ETA display.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google Sign-In OAuth Client IDs (Google Cloud Console -> APIs & Services ->
# Credentials -> OAuth 2.0 Client IDs). Each platform needs its own client
# ID; web is enough to test on Expo web, but native (Expo Go / a real build)
# needs the matching iOS/Android one too. See services/googleAuthConfig.ts.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Firebase -- Authentication (Google/Facebook social sign-in) only for now,
# Cloud Messaging (push) later. Xano remains the primary backend; this is
# NOT used for data storage or business logic. See
# docs/deployment/Firebase.md for exactly what to get from Firebase
# Console and how. All six values below are public client config (like a
# site URL, not a secret) but still kept in .env.local like everything else
# here, never hardcoded in source.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
