# Copy to .env.local and fill in for local development.

# Google Maps (Maps SDK Android/iOS, Directions, Distance Matrix) used for
# rider navigation to merchant/customer.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Firebase -- Authentication (Google/Facebook social sign-in) only for now,
# Cloud Messaging (push) later. Xano remains the primary backend. See
# docs/deployment/Firebase.md for exactly what to get from Firebase
# Console. Same project/values as customer-app's -- one Firebase project
# covers both apps.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Sentry crash reporting (sentry.io -> Settings -> Projects -> Client Keys).
# See services/sentry.ts -- crash reporting stays off (errors only logged
# locally in dev) until this is set.
EXPO_PUBLIC_SENTRY_DSN=
